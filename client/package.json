{
  "name": "kadha",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "sync:changelog": "node scripts/generate-changelog.mjs",
    "typegen": "chakra typegen src/theme/system.ts",
    "predev": "npm run sync:changelog && npm run typegen",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run sync:changelog && npm run typegen",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@chakra-ui/react": "^3.14.2",
    "@emotion/react": "^11.14.0",
    "@tanstack/react-query": "^5.69.0",
    "axios": "^1.8.4",
    "dayjs": "^1.11.13",
    "jotai": "^2.12.2",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.4.0"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.36.1",
    "@eslint/js": "^9.21.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vite": "^6.2.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.10"
  }
