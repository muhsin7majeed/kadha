{
  "name": "kadha-server",
  "version": "0.1.10",
  "description": "A Node.js server for the Kadha application",
  "license": "MIT",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "admin:promote": "tsx src/scripts/promote-admin.ts",
    "db:backup": "tsx src/scripts/database-backup.ts",
    "build": "prisma generate && tsc && tsc-alias",
    "test": "prisma generate && vitest run",
    "test:watch": "vitest",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "axios": "^1.19.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.3.1",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.8.0",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.21.0",
    "typescript": "^5.3.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-uri": "3.1.5",
    "path-to-regexp": "0.1.13"
  }
}
