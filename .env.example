# Server Configuration
PORT=5000
DATABASE_URL=file:./db/dev.db

# Production SQLite backups (optional overrides; Docker production defaults are shown)
DATABASE_BACKUP_DIRECTORY=/app/backups
DATABASE_BACKUP_KEY_FILE=/app/db/.kadha-backup-key
DATABASE_BACKUP_RETENTION=4
# Optional base64-encoded 32-byte key. If omitted, Kadha creates the key file above.
# DATABASE_BACKUP_KEY=

# JWT Secrets
JWT_REFRESH_SECRET=your-refresh-secret-here
JWT_ACCESS_SECRET=your-access-secret-here

# The Movie DB API
TMDB_API_KEY=your-tmdb-api-key-here
TMDB_BEARER_TOKEN=your-tmdb-bearer-token-here

# Client Configuration
APP_NAME=Kadha
CLIENT_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Use none only when the frontend and API are on genuinely different sites.
AUTH_COOKIE_SAME_SITE=strict

# Client Environment Variables (for Vite)
VITE_APP_NAME=Kadha
VITE_APP_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000
